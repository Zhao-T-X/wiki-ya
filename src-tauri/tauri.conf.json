{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wiki-ya",
  "version": "0.1.0",
  "identifier": "app.wikiya.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wiki-ya",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first AI personal knowledge system",
    "longDescription": "wiki-ya 是一个以 Ontology 为核心、以 Evidence 为依据、以 Evolution 为历史、以 Context Efficiency 为 AI 基础设施的 Local-first Personal Knowledge System。"
  }
}
